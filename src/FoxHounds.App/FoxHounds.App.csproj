<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: no console window behind the game on Windows; elsewhere it is an ordinary executable. -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>FoxHounds</AssemblyName>
    <RootNamespace>FoxHounds.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FoxHounds.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Presets are JSON agent specs shipped next to the app, so they can be retuned without a rebuild (spec 13.3). -->
    <None Include="presets\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FoxHounds.Core\FoxHounds.Core.csproj" />
    <ProjectReference Include="..\FoxHounds.Engine\FoxHounds.Engine.csproj" />
    <ProjectReference Include="..\FoxHounds.Solver\FoxHounds.Solver.csproj" />
    <ProjectReference Include="..\FoxHounds.Agents\FoxHounds.Agents.csproj" />
  </ItemGroup>

</Project>
