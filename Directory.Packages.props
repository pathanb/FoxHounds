<Project>
  <!-- Central package management (spec 4.1). Every version in the solution is pinned here, once. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Raylib-cs" Version="8.1.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.14" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Enforces BannedSymbols.txt in every project (spec 4.3: no hidden randomness, no hidden time). -->
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
</Project>
